@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h1 class="mb-4">Privacy Policy</h1>
            <p class="text-muted">Last updated: September 18, 2026</p>

            <hr class="mb-4" />

            <section class="mb-4">
                <h4 class="text-primary">1. Information We Collect</h4>
                <p>When you register an account with <strong>CheckPoint2App</strong>, we collect personal information required for user registration and authentication:</p>
                <ul>
                    <li><strong>Personal Identity:</strong> First Name, Last Name, Email Address, and Password</li>
                    <li><strong>Contact Info:</strong> Contact Number</li>
                    <li><strong>Address Details:</strong> Street Address, Country, State, Province, and Postal Code</li>
                </ul>
            </section>

            <section class="mb-4">
                <h4 class="text-primary">2. How We Use Your Data</h4>
                <p>Your details are used strictly within this application to manage user profiles, verify user login credentials, and store account records in our database.</p>
            </section>

            <section class="mb-4">
                <h4 class="text-primary">3. Data Security</h4>
                <p>We store your account profile securely in our application database and do not share or sell your data to third parties.</p>
            </section>

            <section class="mb-4">
                <h4 class="text-primary">4. Contact Us</h4>
                <p>For questions regarding this policy, contact us at <a href="mailto:support@checkpoint2app.local">support@checkpoint2app.local</a>.</p>
            </section>
        </div>
    </div>
</div>